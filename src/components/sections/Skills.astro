---
import { skills, categoryLabels, type SkillCategory } from '../../data/skills'

const categories = [...new Set(skills.map((s) => s.category))] as SkillCategory[]
---

<section id="skills" data-skills class="section-full flex flex-col items-center justify-center px-6 py-24">
  <h2 class="font-display text-3xl font-bold sm:text-4xl md:text-5xl mb-16">
    Tech <span class="gradient-text">Stack</span>
  </h2>

  <div class="mx-auto grid w-full max-w-4xl gap-10 md:grid-cols-2 lg:grid-cols-3">
    {categories.map((category) => (
      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-text-muted">
          {categoryLabels[category]}
        </h3>
        <div class="flex flex-wrap gap-2">
          {skills
            .filter((s) => s.category === category)
            .map((skill) => (
              <span
                data-skill-pill
                class="rounded-full bg-bg-elevated px-4 py-2 text-sm font-medium text-text-primary ring-1 ring-white/10 transition-colors hover:ring-accent-violet/40"
              >
                {skill.name}
              </span>
            ))}
        </div>
      </div>
    ))}
  </div>
</section>
