---
import GradientBackground from '../ui/GradientBackground.astro'
import SocialLinks from '../ui/SocialLinks.astro'
---

<section id="hero" data-hero class="section-full relative flex flex-col items-center justify-center overflow-hidden px-6">
  <GradientBackground />

  <div class="relative z-10 flex flex-col items-center text-center">
    <h1
      data-hero-title
      class="font-display text-5xl font-bold leading-tight tracking-tight sm:text-7xl md:text-8xl lg:text-9xl"
    >
      FARAZ QURESHI
    </h1>

    <p
      data-hero-subtitle
      class="mt-6 text-lg text-text-secondary sm:text-xl md:text-2xl"
    >
      Software Engineer. Founder. Builder.
    </p>

    <SocialLinks class="mt-8" size="md" />

    <div class="mt-16 animate-bounce">
      <svg
        class="h-6 w-6 text-text-muted"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>
