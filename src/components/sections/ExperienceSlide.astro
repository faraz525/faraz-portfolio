---
import { Image } from 'astro:assets'

interface Props {
  company: string
  role: string
  date: string
  location: string
  bullets: readonly string[]
  techStack: readonly string[]
  logoSrc: ImageMetadata
}

const { company, role, date, location, bullets, techStack, logoSrc } = Astro.props
---

<div
  data-experience-slide
  class="flex h-full w-[85vw] flex-shrink-0 items-center px-6 md:w-[60vw] lg:w-[50vw]"
>
  <div class="mx-auto w-full max-w-lg rounded bg-bg-elevated p-8 ring-1 ring-border clip-cut-corner relative">
    <!-- Orange top accent bar -->
    <div class="absolute top-0 left-0 right-0 h-[2px] bg-accent-orange" />

    <div class="flex items-center gap-4" data-slide-content>
      <div class="h-12 w-12 overflow-hidden rounded-sm bg-bg-inset p-2 flex items-center justify-center">
        <Image
          src={logoSrc}
          alt={`${company} logo`}
          class="h-full w-full object-contain"
          width={48}
          height={48}
        />
      </div>
      <div>
        <h3 class="font-display text-xl font-bold">{company}</h3>
        <p class="text-sm text-text-secondary">{role}</p>
      </div>
    </div>

    <p class="mt-2 font-mono text-xs text-text-muted" data-slide-content>{date} &middot; {location}</p>

    <ul class="mt-5 space-y-3">
      {bullets.map((bullet) => (
        <li class="flex gap-3 text-sm leading-relaxed text-text-secondary" data-slide-content>
          <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent-orange" />
          <span>{bullet}</span>
        </li>
      ))}
    </ul>

    <div class="mt-6 flex flex-wrap gap-2">
      {techStack.map((tech) => (
        <span
          data-tech-pill
          class="font-mono rounded-sm bg-accent-orange-subtle px-3 py-1 text-xs font-medium text-accent-orange ring-1 ring-accent-orange-border"
        >
          {tech}
        </span>
      ))}
    </div>
  </div>
</div>
