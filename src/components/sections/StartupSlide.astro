---
interface Props {
  name: string
  role: string
  date: string
  description: string
  highlights: readonly string[]
  techStack: readonly string[]
  animation: string
  accentColor: string
}

const { name, role, date, description, highlights, techStack, animation, accentColor } = Astro.props
---

<section
  data-startup-slide
  data-startup-animation={animation}
  class="section-full relative flex items-center justify-center overflow-hidden px-6"
>
  <!-- Animated background -->
  <div
    data-startup-bg
    class="absolute inset-0"
    style={`background: radial-gradient(ellipse at center, ${accentColor}10 0%, transparent 60%);`}
  />

  <!-- Content -->
  <div data-startup-content class="relative z-10 mx-auto max-w-2xl text-center">
    <!-- Kicker -->
    <p data-slide-content class="font-mono text-sm tracking-widest text-text-muted">
      <span style={`color: ${accentColor};`}>[</span> {role} <span style={`color: ${accentColor};`}>]</span> &middot; {date}
    </p>

    <h3
      data-slide-content
      class="mt-4 font-display text-4xl font-bold sm:text-5xl md:text-6xl"
      style={`color: ${accentColor};`}
    >
      {name}
    </h3>

    <p data-slide-content class="mt-6 text-lg leading-relaxed text-text-secondary">
      {description}
    </p>

    <!-- Horizontal rule -->
    <div data-slide-content class="mx-auto mt-8 h-[1px] w-10" style={`background-color: ${accentColor};`} />

    <ul data-slide-content class="mt-8 flex flex-col items-center gap-3">
      {highlights.map((highlight) => (
        <li class="flex items-center gap-3 text-text-primary">
          <span class="font-mono text-sm" style={`color: ${accentColor};`}>&rarr;</span>
          <span class="text-base">{highlight}</span>
        </li>
      ))}
    </ul>

    <div data-slide-content class="mt-8 flex flex-wrap justify-center gap-2">
      {techStack.map((tech) => (
        <span
          class="font-mono rounded-sm px-3 py-1 text-xs font-medium ring-1"
          style={`color: ${accentColor}; background-color: ${accentColor}10; border-color: ${accentColor}30;`}
        >
          {tech}
        </span>
      ))}
    </div>
  </div>
</section>
