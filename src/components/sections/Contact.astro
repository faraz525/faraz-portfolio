---
import SocialLinks from '../ui/SocialLinks.astro'
---

<section id="contact" data-contact class="section-full flex flex-col items-center justify-center px-6 py-24">
  <h2
    data-contact-heading
    class="font-display text-4xl font-bold leading-tight text-center sm:text-5xl md:text-6xl max-w-3xl"
  >
    What's the problem you can't stop thinking about?
  </h2>

  <p class="mt-6 text-lg text-text-secondary text-center max-w-lg" data-contact-link>
    Whether it's a startup idea, a systems challenge, or a role where I can build at scale — I'm interested.
  </p>

  <a
    href="mailto:faraz525@uw.edu"
    data-contact-link
    data-contact-cta
    class="mt-10 inline-flex items-center gap-2 rounded-sm bg-accent-orange px-8 py-3.5 font-mono text-sm font-semibold uppercase tracking-wider text-white transition-colors duration-300 hover:bg-accent-orange-glow"
  >
    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
    </svg>
    Start the Conversation
  </a>

  <SocialLinks class="mt-8" size="lg" />

  <p class="mt-24 font-mono text-xs text-text-muted">
    Designed & built by Faraz Qureshi — Astro, GSAP & Tailwind CSS
  </p>
</section>
