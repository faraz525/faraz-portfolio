---
import SocialLinks from '../ui/SocialLinks.astro'
---

<section id="contact" data-contact class="section-full flex flex-col items-center justify-center px-6 py-24">
  <h2
    data-contact-heading
    class="font-display text-4xl font-bold leading-tight text-center sm:text-5xl md:text-6xl max-w-3xl"
  >
    Let's build something together.
  </h2>

  <p class="mt-6 text-lg text-text-secondary text-center max-w-md" data-contact-link>
    Always open to interesting conversations, collaborations, and new opportunities.
  </p>

  <a
    href="mailto:faraz525@uw.edu"
    data-contact-link
    class="mt-10 inline-flex items-center gap-2 rounded-full bg-accent-violet px-8 py-3.5 text-base font-semibold text-white transition-all duration-300 hover:bg-accent-purple hover:scale-105"
  >
    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
    </svg>
    Get in Touch
  </a>

  <SocialLinks class="mt-8" size="lg" />

  <p class="mt-24 text-xs text-text-muted">
    Built with Astro, GSAP & Tailwind CSS
  </p>
</section>
