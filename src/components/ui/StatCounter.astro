---
interface Props {
  prefix?: string
  value: number
  suffix?: string
  label: string
  sublabel: string
  gradient: [string, string]
  hidden?: boolean
}

const { prefix = '', value, suffix = '', label, sublabel, gradient, hidden = false } = Astro.props
---

<div
  class:list={[
    'absolute inset-0 flex flex-col items-center justify-center text-center px-6',
    { 'opacity-0': hidden },
  ]}
  data-stat-slide
  style={hidden ? 'display: none;' : ''}
>
  <div
    class="absolute inset-0 opacity-0 transition-opacity duration-700"
    data-stat-bg
    style={`background: radial-gradient(ellipse at center, ${gradient[0]}20 0%, transparent 70%);`}
  />
  <p
    class="relative font-display text-7xl font-bold tracking-tight sm:text-8xl md:text-9xl"
    data-stat-value
    data-count-to={value}
    data-prefix={prefix}
    data-suffix={suffix}
  >
    {prefix}{value.toLocaleString()}{suffix}
  </p>
  <p class="relative mt-4 text-xl text-text-secondary sm:text-2xl md:text-3xl" data-stat-label>
    {label}
  </p>
  <p class="relative mt-2 text-sm text-text-muted sm:text-base" data-stat-sublabel>
    {sublabel}
  </p>
</div>
