---

<div
  data-scroll-progress
  class="fixed top-0 left-0 z-50 h-[3px] w-0 bg-gradient-to-r from-accent-orange to-accent-orange-dim"
>
  <!-- Leading dot -->
  <div class="absolute right-0 top-1/2 -translate-y-1/2 h-2 w-2 rounded-full bg-accent-orange shadow-[0_0_8px_rgba(255,107,43,0.5)]" />
</div>

<script>
  function initScrollProgress() {
    const bar = document.querySelector('[data-scroll-progress]') as HTMLElement
    if (!bar) return

    function updateProgress() {
      const scrollTop = window.scrollY
      const docHeight = document.documentElement.scrollHeight - window.innerHeight
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0
      bar.style.width = `${progress}%`
    }

    window.addEventListener('scroll', updateProgress, { passive: true })
    updateProgress()
  }

  document.addEventListener('DOMContentLoaded', initScrollProgress)
</script>
